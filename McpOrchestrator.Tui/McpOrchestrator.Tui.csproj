<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<ProjectReference Include="..\McpOrchestrator\McpOrchestrator.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Terminal.Gui" Version="2.4.17" />
	</ItemGroup>

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>mcporch</ToolCommandName>
		<PackageId>McpOrchestrator.Tui</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<!-- Expose internal test seams (e.g. CapabilityCatalog.FromDescriptors, ToolPayloads). -->
		<InternalsVisibleTo Include="McpOrchestrator.Tui.Tests" />
	</ItemGroup>

</Project>
